# Copy to .env for local overrides. docker-compose.yml already sets sane defaults
# for the containerized stack; this file is only needed if you run Flask outside
# Docker or want to tweak game tuning without editing compose.

FLASK_SECRET_KEY=dev-secret-change-me

# When running Flask outside Docker, point at the Postgres container:
DATABASE_URL=postgresql+psycopg://silo:silo@localhost:5432/silo

# Public-facing Grafana URL the player gets redirected to.
GRAFANA_URL=http://localhost:3000
GRAFANA_DASHBOARD_UID=silo-environment

# Game tuning — radiation
INITIAL_RADIATION=100.0
# Uniform jitter ± this many rads on the displayed reading each sample (true level is smooth).
RADIATION_DISPLAY_NOISE_MAX=5.0
DECAY_TICK_SECONDS=30
DECAY_HALF_LIFE_SECONDS=600

# Game tuning — population & loyalty
INITIAL_POPULATION=100
INITIAL_LOYALTY=100.0
RADIATION_SAFE_THRESHOLD=50.0
BASE_DEPARTURE_RATE=0.05

# Game tuning — energy & crank
INITIAL_ENERGY=100.0
LIGHTS_POWER_DRAW=0.01
CRANK_POWER_PER_WORKER=0.01
CRANK_WORKERS_LOYALTY_THRESHOLD=10
CRANK_WORKERS_LOYALTY_PENALTY=0.5
MANUAL_CRANK_ENERGY=1.0

# Game tuning — farming
INITIAL_FOOD=1000.0
FOOD_PER_CAPITA_PER_SECOND=0.1
FOOD_PER_WORKER_PER_SECOND=0.5
FARM_PLANT_GROWTH_SECONDS=300
FARM_HARVEST_YIELD=50.0
