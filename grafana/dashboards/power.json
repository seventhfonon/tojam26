          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT NOW() AS time, CASE WHEN lights_on THEN 1 ELSE 0 END AS lights FROM bunker_systems WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid"
        }
