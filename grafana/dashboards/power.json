  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "html",
        "content": "<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">☢&nbsp; Environment&nbsp;↗</a><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(31,111,235,0.15);border:1px solid #1f6feb;color:#58a6ff;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">⚡&nbsp; Power Systems</span><a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">🌾&nbsp; Farming&nbsp;↗</a></div>"
      }
    },
    {
      "id": 9,
      "type": "text",
      "title": "📡 System Messages",
      "datasource": null,
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 5},
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-log {\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n  background: #0d0d0d;\n  padding: 8px 12px;\n  height: 100%;\n  box-sizing: border-box;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  border-radius: 3px;\n}\n.silo-log .msg { margin: 1px 0; }\n.silo-log .ts { color: #3a3a3a; font-size: 10px; margin-right: 6px; }\n.silo-log .prefix { color: #555; margin-right: 4px; }\n.silo-log .body { color: #8fbc8f; }\n.silo-log .empty { color: #333; font-style: italic; }\n</style>\n<div class=\"silo-log\" id=\"_silo_log\"><span class=\"empty\">Awaiting transmissions...</span></div>\n<script>\nfunction _siloLoadMsgs() {\n  fetch('http://localhost:5001/system-messages?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(msgs) {\n      var el = document.getElementById('_silo_log');\n      if (!msgs || !msgs.length) {\n        el.innerHTML = '<span class=\"empty\">Awaiting transmissions...</span>';\n        return;\n      }\n      el.innerHTML = msgs.map(function(m) {\n        var safe = m.body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n        return '<div class=\"msg\"><span class=\"ts\">[' + m.ts + ']</span><span class=\"prefix\">&gt;</span><span class=\"body\">' + safe + '</span></div>';\n      }).join('');\n      el.scrollTop = el.scrollHeight;\n    })\n    .catch(function() {});\n}\n_siloLoadMsgs();\nsetInterval(_siloLoadMsgs, 5000);\n</script>"
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "⚡ Power Management",
      "description": "Actions fire silently in the background — the dashboard updates within 2 seconds without any page navigation.",
      "datasource": null,
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 7},
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-btn {\n  display: inline-block;\n  padding: 11px 22px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: 0.4px;\n  font-family: Inter, sans-serif;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.4);\n  transition: opacity 0.15s;\n  color: #fff;\n}\n.silo-btn:disabled { opacity: 0.45; cursor: not-allowed; }\n.silo-btn--orange { background: #e67e00; }\n.silo-btn--blue   { background: #1f6feb; }\n.silo-btn--gray   { background: #555; font-size: 18px; padding: 9px 18px; }\n.silo-btn--green  { background: #2ea043; font-size: 18px; padding: 9px 18px; }\n</style>\n<script>\nfunction siloAction(btn, url) {\n  btn.disabled = true;\n  var f = document.getElementById('_silo_frame');\n  if (!f) {\n    f = document.createElement('iframe');\n    f.id = '_silo_frame';\n    f.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:0;';\n    document.body.appendChild(f);\n  }\n  f.src = url;\n  setTimeout(function() { btn.disabled = false; }, 600);\n}\n</script>\n<div style=\"padding: 20px; font-family: Inter, sans-serif; height: 100%; box-sizing: border-box;\">\n  <div style=\"display: flex; gap: 14px; flex-wrap: wrap; align-items: center;\">\n    <button class=\"silo-btn silo-btn--orange\"\n      onclick=\"siloAction(this, 'http://localhost:5001/action/crank?user_id=${user_id}')\">\n      ⚙ CRANK LEVER (+1 energy)\n    </button>\n    <button class=\"silo-btn silo-btn--blue\"\n      onclick=\"siloAction(this, 'http://localhost:5001/action/toggle-lights?user_id=${user_id}')\">\n      💡 TOGGLE LIGHTS (0.01 energy/s)\n    </button>\n    <span style=\"color:#888; font-size:13px; margin-left:6px;\">Crank workers:</span>\n    <button class=\"silo-btn silo-btn--gray\"\n      onclick=\"siloAction(this, 'http://localhost:5001/action/adjust-crank?user_id=${user_id}&delta=-1')\">\n      &minus;\n    </button>\n    <button class=\"silo-btn silo-btn--green\"\n      onclick=\"siloAction(this, 'http://localhost:5001/action/adjust-crank?user_id=${user_id}&delta=1')\">\n      +\n    </button>\n  </div>\n  <p style=\"margin:14px 0 0; color:#666; font-size:12px;\">⚠ Assigning more than 10 workers to the crank reduces loyalty each tick. Manual cranking is tiring but keeps morale intact. Crank and farm workers share the bunker population cap (see Farming dashboard).</p>\n</div>"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Energy reserves",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 0, "y": 15, "w": 6, "h": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 20},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 80}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, level FROM energy_reserves WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid ORDER BY timestamp DESC LIMIT 1"
        }
      ]
    },
