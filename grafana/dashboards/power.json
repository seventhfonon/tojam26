{
  "uid": "silo-power",
  "title": "Silo: Power Systems",
  "tags": ["silo", "game"],
  "schemaVersion": 39,
  "version": 5,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "2s",
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m"]
  },
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User ID",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""},
        "options": [],
        "hide": 2,
        "skipUrlSync": false
      }
    ]
