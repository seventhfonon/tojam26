{
  "uid": "silo-main",
  "title": "Silo: Bunker Telemetry",
  "tags": ["silo", "game"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 2,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outdoor radiation (rads)",
      "description": "Measured external radiation level. The world is recovering, whether the player believes it or not.",
      "datasource": {
        "type": "postgres",
        "uid": "silo-postgres"
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 4,
            "showPoints": "auto",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, level AS \"Outdoor radiation\" FROM radiation_levels WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest reading",
      "datasource": {
        "type": "postgres",
        "uid": "silo-postgres"
      },
      "gridPos": {"x": 0, "y": 10, "w": 8, "h": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 25},
              {"color": "orange", "value": 50},
              {"color": "red", "value": 75}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, level FROM radiation_levels WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid ORDER BY timestamp DESC LIMIT 1"
        }
      ]
    }
  ]
}
