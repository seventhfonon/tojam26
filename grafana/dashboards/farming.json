{
  "uid": "silo-farming",
  "title": "Silo: Farming",
  "tags": ["silo", "game"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "2s",
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m"]
  },
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User ID",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""},
        "options": [],
        "hide": 2,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "html",
        "content": "<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">☢&nbsp; Environment&nbsp;↗</a><a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">⚡&nbsp; Power Systems&nbsp;↗</a><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(46,160,67,0.15);border:1px solid #2ea043;color:#56d364;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">🌾&nbsp; Farming</span></div>"
      }
    },
    {
      "id": 9,
      "type": "text",
      "title": "📡 System Messages",
      "datasource": null,
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 5},
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-log {\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n  background: #0d0d0d;\n  padding: 8px 12px;\n  height: 100%;\n  box-sizing: border-box;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  border-radius: 3px;\n}\n.silo-log .msg { margin: 1px 0; }\n.silo-log .ts { color: #3a3a3a; font-size: 10px; margin-right: 6px; }\n.silo-log .prefix { color: #555; margin-right: 4px; }\n.silo-log .body { color: #8fbc8f; }\n.silo-log .empty { color: #333; font-style: italic; }\n</style>\n<div class=\"silo-log\" id=\"_silo_log\"><span class=\"empty\">Awaiting transmissions...</span></div>\n<script>\nfunction _siloLoadMsgs() {\n  fetch('http://localhost:5001/system-messages?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(msgs) {\n      var el = document.getElementById('_silo_log');\n      if (!msgs || !msgs.length) {\n        el.innerHTML = '<span class=\"empty\">Awaiting transmissions...</span>';\n        return;\n      }\n      el.innerHTML = msgs.map(function(m) {\n        var safe = m.body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n        return '<div class=\"msg\"><span class=\"ts\">[' + m.ts + ']</span><span class=\"prefix\">&gt;</span><span class=\"body\">' + safe + '</span></div>';\n      }).join('');\n      el.scrollTop = el.scrollHeight;\n    })\n    .catch(function() {});\n}\n_siloLoadMsgs();\nsetInterval(_siloLoadMsgs, 5000);\n</script>"
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "🌾 Farm management",
      "description": "Farm workers share the bunker population with power crank workers. Planting starts a 5-minute grow timer before harvest unlocks (+50 food).",
      "datasource": null,
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-btn {\n  display: inline-block;\n  padding: 11px 22px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: 0.4px;\n  font-family: Inter, sans-serif;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.4);\n  transition: opacity 0.15s;\n  color: #fff;\n}\n.silo-btn:disabled { opacity: 0.45; cursor: not-allowed; }\n.silo-btn--green { background: #2ea043; }\n.silo-btn--brown { background: #8b5a2b; }\n.silo-btn--gold { background: #d4a017; }\n.silo-btn--gray   { background: #555; font-size: 18px; padding: 9px 18px; }\n</style>\n<script>\nfunction _siloSyncHarvestBtn() {\n  var b = document.getElementById('_silo_harvest_btn');\n  if (!b) return;\n  fetch('http://localhost:5001/farming/crop-status?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(d) { b.disabled = !d.harvest_ready; })\n    .catch(function() { b.disabled = true; });\n}\nfunction siloAction(btn, url) {\n  btn.disabled = true;\n  var f = document.getElementById('_silo_frame');\n  if (!f) {\n    f = document.createElement('iframe');\n    f.id = '_silo_frame';\n    f.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:0;';\n    document.body.appendChild(f);\n  }\n  f.src = url;\n  setTimeout(function() {\n    btn.disabled = false;\n    _siloSyncHarvestBtn();\n  }, 600);\n}\n_siloSyncHarvestBtn();\nsetInterval(_siloSyncHarvestBtn, 2000);\n</script>\n<div style=\"padding: 20px; font-family: Inter, sans-serif; height: 100%; box-sizing: border-box;\">\n  <div style=\"display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 14px;\">\n    <span style=\"color:#888; font-size:13px;\">Farm workers:</span>\n    <button type=\"button\" class=\"silo-btn silo-btn--gray\" onclick=\"siloAction(this, 'http://localhost:5001/action/adjust-food?user_id=${user_id}&delta=-1')\">&minus;</button>\n    <button type=\"button\" class=\"silo-btn silo-btn--gray\" onclick=\"siloAction(this, 'http://localhost:5001/action/adjust-food?user_id=${user_id}&delta=1')\">+</button>\n  </div>\n  <div style=\"display: flex; gap: 14px; flex-wrap: wrap; align-items: center;\">\n    <button type=\"button\" class=\"silo-btn silo-btn--brown\" onclick=\"siloAction(this, 'http://localhost:5001/action/plant-crops?user_id=${user_id}')\">🌱 PLANT CROPS</button>\n    <button type=\"button\" class=\"silo-btn silo-btn--gold\" id=\"_silo_harvest_btn\" disabled onclick=\"siloAction(this,'http://localhost:5001/action/harvest-crops?user_id=${user_id}')\">🌾 HARVEST (+50)</button>\n  </div>\n  <p style=\"margin:14px 0 0; color:#666; font-size:12px;\">Assigning farm workers does not reduce loyalty. Workers assigned here and on the Power dashboard cannot exceed bunker population.</p>\n</div>"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Food stores",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 200},
              {"color": "yellow", "value": 500},
              {"color": "green", "value": 800}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, level FROM food_reserves WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid ORDER BY timestamp DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Farm workers",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT NOW() AS time, food_workers FROM bunker_systems WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Crop status",
      "description": "Idle → Growing (5 min) → Ready to harvest.",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "text", "value": null},
              {"color": "blue", "value": 1},
              {"color": "green", "value": 2}
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Idle", "color": "text", "index": 0},
                "1": {"text": "Growing", "color": "blue", "index": 1},
                "2": {"text": "Ready", "color": "green", "index": 2}
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT NOW() AS time, CASE WHEN crop_ready_at IS NULL THEN 0 WHEN crop_ready_at > NOW() THEN 1 ELSE 2 END AS status FROM bunker_systems WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Food stores and flow rates",
      "description": "Stockpile level and instantaneous consumption (population × 0.1/s) vs farm production (workers × 0.5/s) as recorded each tick.",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 0, "y": 21, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 12,
            "pointSize": 4,
            "showPoints": "auto",
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Food stores"},
            "properties": [
              {"id": "custom.axisPlacement", "value": "left"},
              {"id": "unit", "value": "none"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Consumption per s"},
            "properties": [
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "unit", "value": "none"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Production per s"},
            "properties": [
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "unit", "value": "none"}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, level AS \"Food stores\" FROM food_reserves WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid AND $__timeFilter(timestamp) ORDER BY timestamp"
        },
        {
          "refId": "B",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, consumption_per_second AS \"Consumption per s\" FROM food_reserves WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid AND $__timeFilter(timestamp) ORDER BY timestamp"
        },
        {
          "refId": "C",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, production_per_second AS \"Production per s\" FROM food_reserves WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    }
  ]
}
