      "options": {
        "mode": "html",
        "content": "<style>\n.focus-tree-nav a:hover { color:#c9d1d9!important; border-color:#30363d!important; }\n.focus-tree-card {\n  font-family: Inter, sans-serif;\n  height:100%;\n  box-sizing:border-box;\n  padding:14px 16px;\n  border:1px solid #30363d;\n  border-radius:8px;\n  background:#161b22;\n  display:flex;\n  flex-direction:column;\n  gap:8px;\n}\n.focus-tree-title { margin:0; font-size:16px; font-weight:700; color:#e6edf3; }\n.focus-tree-desc { margin:0; font-size:13px; line-height:1.45; color:#8b949e; flex:1; }\n.focus-tree-req-head {\n  margin:0;\n  font-size:10px;\n  font-weight:700;\n  letter-spacing:0.12em;\n  text-transform:uppercase;\n  color:#6e7681;\n}\n.focus-tree-req { margin:0; font-size:12px; color:#d4a72c; line-height:1.4; }\n.focus-tree-btn {\n  display:inline-block;\n  align-self:flex-start;\n  margin-top:4px;\n  padding:10px 18px;\n  border:none;\n  border-radius:6px;\n  cursor:pointer;\n  font-weight:700;\n  font-size:13px;\n  font-family:Inter,sans-serif;\n  background:#238636;\n  color:#fff;\n  box-shadow:0 2px 6px rgba(0,0,0,0.35);\n}\n.focus-tree-btn:disabled { opacity:0.45; cursor:not-allowed; }\n.focus-tree-done {\n  margin-top:6px;\n  font-size:13px;\n  font-weight:700;\n  color:#3fb950;\n}\n</style>\n<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n    window.SILO_FOCUS_UID = uid;\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<script>\nwindow.SILO_FOCUS_IDS = [\"ft_explore_novel_food_sources\", \"ft_fireside_chats\", \"ft_bunker_shakespeare_company\", \"ft_venture_out\", \"ft_worse_than_being_exploited\", \"ft_not_being_exploited\", \"ft_fire_and_brimstone\"];\nfunction siloFocusTreePoll() {\n  var uid = window.SILO_FOCUS_UID || '';\n  if (!uid) return;\n  fetch('http://localhost:5001/systems/focus-tree-status?user_id=' + encodeURIComponent(uid))\n    .then(function(r) { return r.json(); })\n    .then(function(d) {\n      var nodes = (d && d.nodes) || {};\n      window.SILO_FOCUS_IDS.forEach(function(id) {\n        var st = nodes[id] || {};\n        var btn = document.getElementById('_focus_btn_' + id);\n        var done = document.getElementById('_focus_done_' + id);\n        if (!btn || !done) return;\n        if (st.completed) {\n          btn.style.display = 'none';\n          done.style.display = 'block';\n        } else {\n          btn.style.display = 'inline-block';\n          done.style.display = 'none';\n          btn.disabled = !st.can_activate;\n        }\n      });\n    })\n    .catch(function() {});\n}\nfunction siloFocusAction(btn, url) {\n  btn.disabled = true;\n  var f = document.getElementById('_silo_frame');\n  if (!f) {\n    f = document.createElement('iframe');\n    f.id = '_silo_frame';\n    f.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:0;';\n    document.body.appendChild(f);\n  }\n  f.src = url;\n  setTimeout(function() {\n    btn.disabled = false;\n    siloFocusTreePoll();\n  }, 600);\n}\nfunction siloFocusTreeComplete(btn, nodeId) {\n  var uid = window.SILO_FOCUS_UID || '';\n  var url = 'http://localhost:5001/action/focus-tree-complete?user_id=' + encodeURIComponent(uid)\n    + '&node_id=' + encodeURIComponent(nodeId);\n  siloFocusAction(btn, url);\n}\nsiloFocusTreePoll();\nsetInterval(siloFocusTreePoll, 2000);\n</script>\n<div class=\"focus-tree-nav\" style=\"display:flex;flex-wrap:nowrap;align-items:flex-start;gap:10px 12px;padding:8px 16px;width:100%;min-height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\">\n<div style=\"flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;\">\n<span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span>\n<div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div>\n<a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#9762;&nbsp; Environment&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#9889;&nbsp; Power Systems&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#127806;&nbsp; Farming&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-inner-circle?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#128081;&nbsp; Inner Circle&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-community?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#128101;&nbsp; Community&nbsp;&#8599;</a>\n<span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(46,160,67,0.15);border:1px solid #2ea043;color:#3fb950;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">&#127795;&nbsp; Focus Tree</span>\n</div><!--silo-bgm-injected--><style>\n.silo-bgm-bar {\n  font-family: Inter, sans-serif;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 10px;\n  box-sizing: border-box;\n  border: 1px solid #30363d;\n  border-radius: 6px;\n  background: #161b22;\n  color: #8b949e;\n  font-size: 12px;\n}\n.silo-bgm-bar--nav {\n  flex-shrink: 0;\n}\n.silo-bgm-bar button {\n  padding: 6px 12px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 12px;\n  font-family: Inter, sans-serif;\n  background: #8957e5;\n  color: #fff;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);\n}\n.silo-bgm-bar button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n</style>\n<div id=\"_silo_bgm_wrap\" class=\"silo-bgm-bar silo-bgm-bar--nav\">\n  <button type=\"button\" id=\"_silo_bgm_btn\">Enable bunker audio</button>\n  <span id=\"_silo_bgm_status\">Optional bunker audio</span>\n</div>\n<script>\n(function siloBgmDashAudio() {\n  var TRACK = ('${bgm_url}' || '').trim();\n  var DASH = ('${dashboard_uid}' || '').trim();\n  var wrap = document.getElementById('_silo_bgm_wrap');\n  var btn = document.getElementById('_silo_bgm_btn');\n  var statusEl = document.getElementById('_silo_bgm_status');\n\n  if (!TRACK) {\n    if (wrap) wrap.style.display = 'none';\n    return;\n  }\n\n  var LS_KEY = 'silo_bgm_enabled';\n\n  var prev = window.__SILO_BGM__;\n  if (prev && prev.trackUrl === TRACK && prev.audio && typeof prev.remount === 'function') {\n    prev.dash = DASH;\n    prev.remount(wrap, btn, statusEl);\n    return;\n  }\n\n  if (prev && typeof prev.destroy === 'function') {\n    prev.destroy();\n  }\n\n  var audio = new Audio(TRACK);\n  audio.loop = true;\n  audio.volume = 0.35;\n\n  var navBtn = null;\n  var navStatus = null;\n\n  function teardown() {\n    if (api._onVis) {\n      document.removeEventListener('visibilitychange', api._onVis);\n    }\n    if (navBtn && api._onBtnClick) {\n      navBtn.removeEventListener('click', api._onBtnClick);\n    }\n    try {\n      audio.pause();\n      audio.removeAttribute('src');\n      audio.load();\n    } catch (e) {}\n  }\n\n  function onVis() {\n    if (document.hidden) {\n      audio.pause();\n    } else {\n      try {\n        if (localStorage.getItem(LS_KEY) === '1') {\n          tryPlay(false);\n        }\n      } catch (e) {}\n    }\n  }\n\n  function tryPlay(fromUser) {\n    var p = audio.play();\n    if (p !== undefined && typeof p.then === 'function') {\n      p.then(function () {\n        if (navBtn) navBtn.style.display = 'none';\n        if (navStatus) navStatus.textContent = 'Playing';\n      }).catch(function () {\n        if (navBtn) navBtn.style.display = '';\n        if (navStatus && !fromUser) {\n          navStatus.textContent = 'Tap Enable to play';\n        }\n      });\n    }\n  }\n\n  function remount(wrapEl, btnEl, statusElEl) {\n    if (navBtn && api._onBtnClick) {\n      navBtn.removeEventListener('click', api._onBtnClick);\n    }\n    navBtn = btnEl;\n    navStatus = statusElEl;\n    if (btnEl) {\n      btnEl.addEventListener('click', api._onBtnClick);\n    }\n    if (!audio.paused) {\n      if (btnEl) btnEl.style.display = 'none';\n      if (statusElEl) statusElEl.textContent = 'Playing';\n    } else {\n      if (btnEl) btnEl.style.display = '';\n      if (statusElEl && !document.hidden) {\n        try {\n          if (localStorage.getItem(LS_KEY) === '1') {\n            statusElEl.textContent = 'Tap Enable to play';\n          } else {\n            statusElEl.textContent = 'Optional bunker audio';\n          }\n        } catch (e) {\n          statusElEl.textContent = 'Optional bunker audio';\n        }\n      }\n    }\n  }\n\n  var api = {\n    dash: DASH,\n    trackUrl: TRACK,\n    destroy: function () {\n      teardown();\n      if (window.__SILO_BGM__ === api) {\n        window.__SILO_BGM__ = null;\n      }\n    },\n    audio: audio,\n    remount: remount,\n    _onVis: onVis,\n    _onBtnClick: function () {\n      try {\n        localStorage.setItem(LS_KEY, '1');\n      } catch (e) {}\n      tryPlay(true);\n    },\n  };\n\n  window.__SILO_BGM__ = api;\n\n  document.addEventListener('visibilitychange', onVis);\n\n  remount(wrap, btn, statusEl);\n\n  try {\n    if (localStorage.getItem(LS_KEY) === '1') {\n      tryPlay(false);\n    }\n  } catch (e) {}\n})();\n</script>\n<script>\n(function siloDashSfx() {\n  var urls = {\n    buttonClick: ('${sfx_button_click_url}' || '').trim(),\n  };\n\n  var pools = {};\n\n  function playUrl(url) {\n    if (!url) return;\n    var pool = pools[url];\n    if (!pool) {\n      pool = [];\n      pools[url] = pool;\n      for (var i = 0; i < 4; i++) {\n        var a = new Audio(url);\n        a.volume = 1;\n        pool.push(a);\n      }\n    }\n    var audio = pool[0];\n    var i;\n    for (i = 0; i < pool.length; i++) {\n      if (pool[i].paused || pool[i].ended) {\n        audio = pool[i];\n        break;\n      }\n      audio = pool[i];\n    }\n    try {\n      audio.currentTime = 0;\n      var p = audio.play();\n      if (p !== undefined && typeof p.then === 'function') {\n        p.catch(function () {});\n      }\n    } catch (e) {}\n  }\n\n  var api = {\n    urls: urls,\n    play: function (id) {\n      var u = urls[id];\n      if (!u) return;\n      playUrl(u);\n    },\n    register: function (id, url) {\n      if (!id) return;\n      urls[id] = (url || '').trim();\n    },\n  };\n\n  window.__SILO_SFX__ = api;\n\n  if (window.__SILO_SFX_CLICK_BOUND__) return;\n  window.__SILO_SFX_CLICK_BOUND__ = true;\n\n  document.addEventListener(\n    'click',\n    function (ev) {\n      var t = ev.target;\n      while (t && t.nodeType !== 1) t = t.parentElement;\n      if (!t || typeof t.closest !== 'function') return;\n      var el = t.closest('button');\n      if (!el) {\n        el = t.closest('input[type=\"button\"], input[type=\"submit\"]');\n      }\n      if (!el) return;\n\n      var sfxId = 'buttonClick';\n      var node = t;\n      while (node) {\n        if (node.hasAttribute && node.hasAttribute('data-sfx')) {\n          var v = node.getAttribute('data-sfx');\n          v = (v || '').trim();\n          if (v === 'none') return;\n          sfxId = v;\n          break;\n        }\n        if (node === el) break;\n        node = node.parentElement;\n      }\n\n      var sfx = window.__SILO_SFX__;\n      if (!sfx || typeof sfx.play !== 'function') return;\n      sfx.play(sfxId);\n    },\n    true\n  );\n})();\n</script>\n<!--/silo-bgm-injected--></div>\n\n\n\n<script>\n(function siloUiGatesBootstrap(){\n var dashUid=('${dashboard_uid}').replace(/^\\s+|\\s+$/g,'');\n if(!dashUid||dashUid.indexOf('$')>=0){{\n  try{{\n   var m=window.location.pathname.match(/\\/d\\/([^/]+)/);\n   dashUid=m?decodeURIComponent(m[1]):'';\n  }}catch(e){{dashUid='';}}\n }}\n var uid=('${user_id}').replace(/^\\s+|\\s+$/g,'');\n if(uid){{try{{localStorage.setItem('silo_user_id',uid);}}catch(e){{}}}}\n else{{try{{uid=localStorage.getItem('silo_user_id')||'';}}catch(e){{uid='';}}}}\n var applied=Object.create(null);\n function rootsForPanel(panelId){{\n  var out=[];\n  ['[data-panel-id=\"'+panelId+'\"]','[data-panelid=\"'+panelId+'\"]'].forEach(function(sel){{\n   document.querySelectorAll(sel).forEach(function(el){{\n    var wrap=\n     el.closest('[data-testid=\"dashboard-panel-container\"]')||\n     el.closest('[data-testid=\"panel-container\"]')||\n     el.closest('section[aria-label]')||\n     el.closest('section')||\n     el.closest('[class*=\"panel-container\"]');\n    if(!wrap){{\n     var n=el;\n     for(var i=0;i<28&&n;i++){{\n      var cn=n.className&&String(n.className)||'';\n      var cnl=cn.toLowerCase();\n      if(cnl.indexOf('panelchrome')>=0||cnl.indexOf('panel-container')>=0){{wrap=n;break;}}\n      n=n.parentElement;\n     }}\n    }}\n    if(!wrap)wrap=el;\n    if(wrap&&out.indexOf(wrap)<0)out.push(wrap);\n   }});\n  }});\n  return out;\n }}\n function tick(){{\n  if(!dashUid)return;\n  if(!uid)return;\n  fetch('http://localhost:5001/systems/ui-gates?user_id='+encodeURIComponent(uid)+'&dashboard_uid='+encodeURIComponent(dashUid))\n   .then(function(r){{return r.json();}})\n   .then(function(data){{\n    var hide=(data&&data.hide_panel_ids)||[];\n    var hideSet={};\n    hide.forEach(function(id){{hideSet[String(id)]=true;}});\n    Object.keys(applied).forEach(function(id){{\n     if(!hideSet[id]){{\n      applied[id].forEach(function(el){{el.style.display='';}});\n      delete applied[id];\n     }}\n    }});\n    hide.forEach(function(pid){{\n     var idStr=String(pid);\n     var els=rootsForPanel(pid);\n     if(!els.length)return;\n     if(!applied[idStr])applied[idStr]=[];\n     els.forEach(function(el){{\n      el.style.display='none';\n      if(applied[idStr].indexOf(el)<0)applied[idStr].push(el);\n     }});\n    }});\n   }}).catch(function(){{}});\n }}\n tick();\n setInterval(tick,1500);\n}})();\n</script>\n"
      }
