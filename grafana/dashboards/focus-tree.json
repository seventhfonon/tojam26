      "options": {
        "mode": "html",
        "content": "<style>\n.focus-tree-nav a:hover { color:#c9d1d9!important; border-color:#30363d!important; }\n.focus-tree-card {\n  font-family: Inter, sans-serif;\n  height:100%;\n  box-sizing:border-box;\n  padding:14px 16px;\n  border:1px solid #30363d;\n  border-radius:8px;\n  background:#161b22;\n  display:flex;\n  flex-direction:column;\n  gap:8px;\n}\n.focus-tree-title { margin:0; font-size:16px; font-weight:700; color:#e6edf3; }\n.focus-tree-desc { margin:0; font-size:13px; line-height:1.45; color:#8b949e; flex:1; }\n.focus-tree-req-head {\n  margin:0;\n  font-size:10px;\n  font-weight:700;\n  letter-spacing:0.12em;\n  text-transform:uppercase;\n  color:#6e7681;\n}\n.focus-tree-req { margin:0; font-size:12px; color:#d4a72c; line-height:1.4; }\n.focus-tree-btn {\n  display:inline-block;\n  align-self:flex-start;\n  margin-top:4px;\n  padding:10px 18px;\n  border:none;\n  border-radius:6px;\n  cursor:pointer;\n  font-weight:700;\n  font-size:13px;\n  font-family:Inter,sans-serif;\n  background:#238636;\n  color:#fff;\n  box-shadow:0 2px 6px rgba(0,0,0,0.35);\n}\n.focus-tree-btn:disabled { opacity:0.45; cursor:not-allowed; }\n.focus-tree-done {\n  margin-top:6px;\n  font-size:13px;\n  font-weight:700;\n  color:#3fb950;\n}\n</style>\n<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n    window.SILO_FOCUS_UID = uid;\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<script>\nwindow.SILO_FOCUS_IDS = [\"ft_command_coordination\", \"ft_supply_audit\", \"ft_waste_loop_review\", \"ft_joint_readiness_board\", \"ft_surface_handshake\"];\nfunction siloFocusTreePoll() {\n  var uid = window.SILO_FOCUS_UID || '';\n  if (!uid) return;\n  fetch('http://localhost:5001/systems/focus-tree-status?user_id=' + encodeURIComponent(uid))\n    .then(function(r) { return r.json(); })\n    .then(function(d) {\n      var nodes = (d && d.nodes) || {};\n      window.SILO_FOCUS_IDS.forEach(function(id) {\n        var st = nodes[id] || {};\n        var btn = document.getElementById('_focus_btn_' + id);\n        var done = document.getElementById('_focus_done_' + id);\n        if (!btn || !done) return;\n        if (st.completed) {\n          btn.style.display = 'none';\n          done.style.display = 'block';\n        } else {\n          btn.style.display = 'inline-block';\n          done.style.display = 'none';\n          btn.disabled = !st.can_activate;\n        }\n      });\n    })\n    .catch(function() {});\n}\nfunction siloFocusAction(btn, url) {\n  btn.disabled = true;\n  var f = document.getElementById('_silo_frame');\n  if (!f) {\n    f = document.createElement('iframe');\n    f.id = '_silo_frame';\n    f.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:0;';\n    document.body.appendChild(f);\n  }\n  f.src = url;\n  setTimeout(function() {\n    btn.disabled = false;\n    siloFocusTreePoll();\n  }, 600);\n}\nfunction siloFocusTreeComplete(btn, nodeId) {\n  var uid = window.SILO_FOCUS_UID || '';\n  var url = 'http://localhost:5001/action/focus-tree-complete?user_id=' + encodeURIComponent(uid)\n    + '&node_id=' + encodeURIComponent(nodeId);\n  siloFocusAction(btn, url);\n}\nsiloFocusTreePoll();\nsetInterval(siloFocusTreePoll, 2000);\n</script>\n<div class=\"focus-tree-nav\" style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\">\n<span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span>\n<div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div>\n<a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#9762;&nbsp; Environment&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#9889;&nbsp; Power Systems&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#127806;&nbsp; Farming&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-inner-circle?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#128081;&nbsp; Inner Circle&nbsp;&#8599;</a>\n<a href=\"http://localhost:3000/d/silo-community?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">&#128101;&nbsp; Community&nbsp;&#8599;</a>\n<span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(46,160,67,0.15);border:1px solid #2ea043;color:#3fb950;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">&#127795;&nbsp; Focus Tree</span>\n</div>\n"
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "Focus \u2014 Command coordination",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "html",
        "content": "<div class=\"focus-tree-card\">\n<h2 class=\"focus-tree-title\">Command coordination</h2>\n<p class=\"focus-tree-desc\">Bring silo departments onto a single incident channel so downstream plans do not fork silently.</p>\n<p class=\"focus-tree-req-head\">Requirements</p>\n<p class=\"focus-tree-req\">No prerequisites \u2014 establish the chain of command.</p>\n<button type=\"button\" class=\"focus-tree-btn\" id=\"_focus_btn_ft_command_coordination\" disabled onclick=\"siloFocusTreeComplete(this,'ft_command_coordination')\">Complete focus</button>\n<div class=\"focus-tree-done\" id=\"_focus_done_ft_command_coordination\" style=\"display:none;\">Completed</div>\n</div>"
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "Focus \u2014 Supply lane audit",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "html",
        "content": "<div class=\"focus-tree-card\">\n<h2 class=\"focus-tree-title\">Supply lane audit</h2>\n<p class=\"focus-tree-desc\">Inventory spare hydro filters and crank lubricant before parallel work stress-tests both corridors.</p>\n<p class=\"focus-tree-req-head\">Requirements</p>\n<p class=\"focus-tree-req\">Complete Command coordination.</p>\n<button type=\"button\" class=\"focus-tree-btn\" id=\"_focus_btn_ft_supply_audit\" disabled onclick=\"siloFocusTreeComplete(this,'ft_supply_audit')\">Complete focus</button>\n<div class=\"focus-tree-done\" id=\"_focus_done_ft_supply_audit\" style=\"display:none;\">Completed</div>\n</div>"
      }
    },
    {
      "id": 12,
      "type": "text",
      "title": "Focus \u2014 Waste-loop review",
      "datasource": null,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "html",
        "content": "<div class=\"focus-tree-card\">\n<h2 class=\"focus-tree-title\">Waste-loop review</h2>\n<p class=\"focus-tree-desc\">Verify compost return paths and gray-water routing so expanded farming does not starve power cooling loops.</p>\n<p class=\"focus-tree-req-head\">Requirements</p>\n<p class=\"focus-tree-req\">Complete Command coordination.</p>\n<button type=\"button\" class=\"focus-tree-btn\" id=\"_focus_btn_ft_waste_loop_review\" disabled onclick=\"siloFocusTreeComplete(this,'ft_waste_loop_review')\">Complete focus</button>\n<div class=\"focus-tree-done\" id=\"_focus_done_ft_waste_loop_review\" style=\"display:none;\">Completed</div>\n</div>"
      }
    },
    {
      "id": 13,
      "type": "text",
      "title": "Focus \u2014 Joint readiness board",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "options": {
        "mode": "html",
        "content": "<div class=\"focus-tree-card\">\n<h2 class=\"focus-tree-title\">Joint readiness board</h2>\n<p class=\"focus-tree-desc\">Merge hydro and power schedules into one board so neither corridor claims the same maintenance window.</p>\n<p class=\"focus-tree-req-head\">Requirements</p>\n<p class=\"focus-tree-req\">Both Supply lane audit and Waste-loop review must be marked complete before this focus unlocks.</p>\n<button type=\"button\" class=\"focus-tree-btn\" id=\"_focus_btn_ft_joint_readiness_board\" disabled onclick=\"siloFocusTreeComplete(this,'ft_joint_readiness_board')\">Complete focus</button>\n<div class=\"focus-tree-done\" id=\"_focus_done_ft_joint_readiness_board\" style=\"display:none;\">Completed</div>\n</div>"
      }
    },
    {
      "id": 14,
      "type": "text",
      "title": "Focus \u2014 Surface handshake drill",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "html",
        "content": "<div class=\"focus-tree-card\">\n<h2 class=\"focus-tree-title\">Surface handshake drill</h2>\n<p class=\"focus-tree-desc\">Timed ping drill with the antenna mast \u2014 proves merged logistics can support a single outbound push.</p>\n<p class=\"focus-tree-req-head\">Requirements</p>\n<p class=\"focus-tree-req\">Complete Joint readiness board.</p>\n<button type=\"button\" class=\"focus-tree-btn\" id=\"_focus_btn_ft_surface_handshake\" disabled onclick=\"siloFocusTreeComplete(this,'ft_surface_handshake')\">Complete focus</button>\n<div class=\"focus-tree-done\" id=\"_focus_done_ft_surface_handshake\" style=\"display:none;\">Completed</div>\n</div>"
      }
    },
    {
      "id": 200,
      "type": "text",
      "title": "BGM",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "html",
        "content": "<!--\n  Paste into Grafana Text panel (HTML mode) options.content, OR run:\n    python scripts/embed_grafana_bgm.py\n  Template vars (hidden constants on each dashboard): ${bgm_url}, ${dashboard_uid}\n\n  Playback pauses only when the browser tab is hidden (visibility API) or when you\n  navigate to another dashboard (singleton). Scrolling the panel off-screen does\n  not pause audio \u2014 Grafana has no built-in \u201csticky panel\u201d; duplicate controls at\n  the top if you want them always visible.\n-->\n<style>\n.silo-bgm-bar {\n  font-family: Inter, sans-serif;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 10px;\n  box-sizing: border-box;\n  border: 1px solid #30363d;\n  border-radius: 6px;\n  background: #161b22;\n  color: #8b949e;\n  font-size: 12px;\n}\n.silo-bgm-bar button {\n  padding: 6px 12px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 12px;\n  font-family: Inter, sans-serif;\n  background: #8957e5;\n  color: #fff;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);\n}\n.silo-bgm-bar button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n</style>\n<div id=\"_silo_bgm_wrap\" class=\"silo-bgm-bar\">\n  <button type=\"button\" id=\"_silo_bgm_btn\">Enable bunker audio</button>\n  <span id=\"_silo_bgm_status\">Optional bunker audio</span>\n</div>\n<script>\n(function siloBgmDashAudio() {\n  var TRACK = ('${bgm_url}' || '').trim();\n  var DASH = ('${dashboard_uid}' || '').trim();\n  var wrap = document.getElementById('_silo_bgm_wrap');\n  var btn = document.getElementById('_silo_bgm_btn');\n  var statusEl = document.getElementById('_silo_bgm_status');\n\n  if (!TRACK) {\n    if (wrap) wrap.style.display = 'none';\n    return;\n  }\n\n  var LS_KEY = 'silo_bgm_enabled';\n  var audio = new Audio(TRACK);\n  audio.loop = true;\n  audio.volume = 0.35;\n\n  function teardown() {\n    document.removeEventListener('visibilitychange', onVis);\n    try {\n      audio.pause();\n      audio.removeAttribute('src');\n      audio.load();\n    } catch (e) {}\n  }\n\n  var api = {\n    dash: DASH,\n    destroy: function () {\n      teardown();\n      if (window.__SILO_BGM__ === api) {\n        window.__SILO_BGM__ = null;\n      }\n    },\n    audio: audio,\n  };\n\n  var prev = window.__SILO_BGM__;\n  if (prev && typeof prev.destroy === 'function') {\n    prev.destroy();\n  }\n  window.__SILO_BGM__ = api;\n\n  function onVis() {\n    if (document.hidden) {\n      audio.pause();\n    } else {\n      try {\n        if (localStorage.getItem(LS_KEY) === '1') {\n          tryPlay(false);\n        }\n      } catch (e) {}\n    }\n  }\n\n  function tryPlay(fromUser) {\n    var p = audio.play();\n    if (p !== undefined && typeof p.then === 'function') {\n      p.then(function () {\n        if (btn) btn.style.display = 'none';\n        if (statusEl) statusEl.textContent = 'Playing';\n      }).catch(function () {\n        if (btn) btn.style.display = '';\n        if (statusEl && !fromUser) {\n          statusEl.textContent = 'Tap Enable to play';\n        }\n      });\n    }\n  }\n\n  document.addEventListener('visibilitychange', onVis);\n\n  if (btn) {\n    btn.addEventListener('click', function () {\n      try {\n        localStorage.setItem(LS_KEY, '1');\n      } catch (e) {}\n      tryPlay(true);\n    });\n  }\n\n  try {\n    if (localStorage.getItem(LS_KEY) === '1') {\n      tryPlay(false);\n    }\n  } catch (e) {}\n})();\n</script>\n"
      }
    }
  ]
}
