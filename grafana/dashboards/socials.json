      "options": {
        "mode": "html",
        "content": "<div style=\"padding:16px 18px;font-family:Inter,sans-serif;color:#c9d1d9;font-size:13px;line-height:1.55;height:100%;box-sizing:border-box;overflow-y:auto;\">\n<style>.council-row{display:flex;gap:10px;padding:6px 0;border-bottom:1px solid #21262d;}.council-role{color:#8b949e;min-width:150px;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;}.council-name{color:#58a6ff;font-weight:600;}</style>\n<div class=\"council-row\"><span class=\"council-role\">Chief Administrator</span><span class=\"council-name\">Marnie Coldwell</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Second Administrator</span><span class=\"council-name\">Jace Orbin</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Chief Engineer</span><span class=\"council-name\">Vesper Kline</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Second Engineer</span><span class=\"council-name\">Rook Halden</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Chief Agriculturalist</span><span class=\"council-name\">Tamsin Greer</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Second Agriculturalist</span><span class=\"council-name\">Ellis Bram</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Chief Expeditioner</span><span class=\"council-name\">Nadia Firth</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Second Expeditioner</span><span class=\"council-name\">Corin Ash</span></div>\n<div class=\"council-row\"><span class=\"council-role\">Chief Medic</span><span class=\"council-name\">Dr. Liora Senn</span></div>\n<div class=\"council-row\" style=\"border-bottom:none;\"><span class=\"council-role\">Second Medic</span><span class=\"council-name\">Theo Marche</span></div>\n</div>"
      }
    },
