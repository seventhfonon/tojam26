    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\u2622&nbsp; Environment&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\u26a1&nbsp; Power Systems&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83c\udf3e&nbsp; Farming&nbsp;\u2197</a><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(31,111,235,0.15);border:1px solid #1f6feb;color:#58a6ff;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">\ud83d\udc65&nbsp; Social</span></div>"
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "\ud83d\udce1 System Messages",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-log {\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n  background: #0d0d0d;\n  padding: 8px 12px;\n  height: 100%;\n  box-sizing: border-box;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  border-radius: 3px;\n}\n.silo-log .msg { margin: 1px 0; }\n.silo-log .ts { color: #3a3a3a; font-size: 10px; margin-right: 6px; }\n.silo-log .prefix { color: #555; margin-right: 4px; }\n.silo-log .body { color: #8fbc8f; }\n.silo-log .empty { color: #333; font-style: italic; }\n</style>\n<div class=\"silo-log\" id=\"_silo_log\"><span class=\"empty\">Awaiting transmissions...</span></div>\n<script>\nfunction _siloLoadMsgs() {\n  fetch('http://localhost:5001/system-messages?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(msgs) {\n      var el = document.getElementById('_silo_log');\n      if (!msgs || !msgs.length) {\n        el.innerHTML = '<span class=\"empty\">Awaiting transmissions...</span>';\n        return;\n      }\n      el.innerHTML = msgs.map(function(m) {\n        var safe = m.body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n        return '<div class=\"msg\"><span class=\"ts\">[' + m.ts + ']</span><span class=\"prefix\">&gt;</span><span class=\"body\">' + safe + '</span></div>';\n      }).join('');\n      el.scrollTop = el.scrollHeight;\n    })\n    .catch(function() {});\n}\n_siloLoadMsgs();\nsetInterval(_siloLoadMsgs, 5000);\n</script>"
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "Social programs",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 9
      },
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-btn {\n  display: inline-block;\n  padding: 11px 22px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 14px;\n  letter-spacing: 0.4px;\n  font-family: Inter, sans-serif;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.4);\n  transition: opacity 0.15s;\n  color: #fff;\n}\n.silo-btn:disabled { opacity: 0.45; cursor: not-allowed; }\n.silo-btn--purple { background: #8957e5; }\n.silo-btn--teal { background: #238636; }\n.silo-btn--gold { background: #9e6a03; }\n.silo-btn--orange { background: #e67e00; }\n</style>\n<script>\nfunction _siloSyncSocialButtons() {\n  var m = document.getElementById('_silo_movie_btn');\n  var s = document.getElementById('_silo_speech_btn');\n  var c = document.getElementById('_silo_council_btn');\n  if (!m || !s || !c) return;\n  fetch('http://localhost:5001/socials/action-status?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(d) {\n      m.disabled = !d.can_show_movie;\n      s.disabled = !d.can_give_speech;\n      c.disabled = !d.can_meet_council;\n    })\n    .catch(function() {\n      m.disabled = true;\n      s.disabled = true;\n      c.disabled = true;\n    });\n}\nfunction _siloSocialSyncInvestigateBtn() {\n  var btn = document.getElementById('_silo_social_investigate_btn');\n  var hint = document.getElementById('_silo_social_inv_hint');\n  if (!btn) return;\n  fetch('http://localhost:5001/systems/investigation-dispatch-status?user_id=${user_id}&system=social')\n    .then(function(r) { return r.json(); })\n    .then(function(d) {\n      btn.disabled = !d.can_dispatch;\n      if (hint) hint.textContent = 'Requires ' + d.team_required + ' idle residents (unassigned to crank, farm, or sweep).';\n    })\n    .catch(function() { btn.disabled = true; });\n}\nfunction siloAction(btn, url) {\n  btn.disabled = true;\n  var f = document.getElementById('_silo_frame');\n  if (!f) {\n    f = document.createElement('iframe');\n    f.id = '_silo_frame';\n    f.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:0;';\n    document.body.appendChild(f);\n  }\n  f.src = url;\n  setTimeout(function() {\n    btn.disabled = false;\n    _siloSyncSocialButtons();\n    _siloSocialSyncInvestigateBtn();\n  }, 600);\n}\n_siloSyncSocialButtons();\n_siloSocialSyncInvestigateBtn();\nsetInterval(_siloSyncSocialButtons, 2000);\nsetInterval(_siloSocialSyncInvestigateBtn, 2000);\n</script>\n<div style=\"padding: 20px; font-family: Inter, sans-serif; height: 100%; box-sizing: border-box;\">\n  <div style=\"display: flex; gap: 12px; flex-wrap: wrap; align-items: center;\">\n    <button type=\"button\" class=\"silo-btn silo-btn--purple\" id=\"_silo_movie_btn\" onclick=\"siloAction(this, 'http://localhost:5001/action/show-movie?user_id=${user_id}')\">SHOW MOVIE</button>\n    <button type=\"button\" class=\"silo-btn silo-btn--teal\" id=\"_silo_speech_btn\" onclick=\"siloAction(this, 'http://localhost:5001/action/give-speech?user_id=${user_id}')\">GIVE SPEECH</button>\n    <button type=\"button\" class=\"silo-btn silo-btn--gold\" id=\"_silo_council_btn\" onclick=\"siloAction(this, 'http://localhost:5001/action/meet-council?user_id=${user_id}')\">MEET WITH COUNCIL</button>\n  </div>\n  <div style=\"margin-top:14px; padding-top:14px; border-top:1px solid #333;\">\n  <p style=\"margin:0 0 10px; color:#c9a227; font-size:13px; font-weight:600;\">Routine compartment sweep</p>\n  <button type=\"button\" class=\"silo-btn silo-btn--orange\" id=\"_silo_social_investigate_btn\" disabled onclick=\"siloAction(this, 'http://localhost:5001/action/dispatch-investigation?user_id=${user_id}&system=social')\">Send investigation team</button>\n  <p id=\"_silo_social_inv_hint\" style=\"margin:10px 0 0; color:#666; font-size:11px;\"></p>\n</div>\n  <p style=\"margin:14px 0 0; color:#666; font-size:12px;\">Movie and speech: 5-minute cooldown each; effects weaken with repeated use. Council: 10-minute cooldown; outcomes appear only in the message log above.</p>\n</div>"
      }
    },
    {
