      "options": {
        "mode": "html",
        "content": "<style id=\"silo-env-heatmap-hide-axis-labels\">\n[data-panelid=\"27\"] .u-axis text,\n[data-panelid=\"27\"] .u-axis .u-value,\n[data-panel-id=\"27\"] .u-axis text,\n[data-panel-id=\"27\"] .u-axis .u-value {\n  display: none !important;\n}\n</style>\n<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<script>\n(function siloSquareHeatmapPanel27() {\n  function findPanels() {\n    var roots = [];\n    ['[data-panelid=\"27\"]', '[data-panel-id=\"27\"]'].forEach(function(sel) {\n      document.querySelectorAll(sel).forEach(function(el) {\n        if (roots.indexOf(el) === -1) roots.push(el);\n      });\n    });\n    if (!roots.length) {\n      document.querySelectorAll('section[aria-label*=\"Sensor field\"]').forEach(function(el) {\n        roots.push(el);\n      });\n    }\n    return roots;\n  }\n\n  function tick() {\n    findPanels().forEach(function(root) {\n      var uplot = root.querySelector('.uplot');\n      if (!uplot) return;\n\n      var inner = root.querySelector('[data-testid*=\"panel-content\"]')\n        || root.querySelector('[data-testid*=\"Panel content\"]')\n        || root.querySelector('[class*=\"panel-content\"]')\n        || root;\n\n      var box = inner.getBoundingClientRect();\n      var rawW = Math.max(box.width - 28, 80);\n      var rawH = Math.max(box.height - 28, 80);\n      var S = Math.floor(Math.min(rawW, rawH));\n      if (S < 80) return;\n\n      var sx = S / rawW;\n      var sy = S / rawH;\n\n      var clip = uplot.closest('[data-testid*=\"viz-layout\"]') || uplot.parentElement;\n      if (!clip) return;\n\n      clip.style.setProperty('overflow', 'hidden', 'important');\n      clip.style.setProperty('width', S + 'px', 'important');\n      clip.style.setProperty('height', S + 'px', 'important');\n      clip.style.setProperty('margin-left', 'auto', 'important');\n      clip.style.setProperty('margin-right', 'auto', 'important');\n      clip.style.setProperty('box-sizing', 'border-box', 'important');\n\n      uplot.style.transformOrigin = 'top left';\n      uplot.style.setProperty('transform', 'scale(' + sx + ',' + sy + ')', 'important');\n    });\n    requestAnimationFrame(tick);\n  }\n\n  requestAnimationFrame(tick);\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(31,111,235,0.15);border:1px solid #1f6feb;color:#58a6ff;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">\u2622&nbsp; Environment</span><a href=\"http://localhost:3000/d/silo-population?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83d\udcca&nbsp; Population&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\u26a1&nbsp; Power Systems&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83c\udf3e&nbsp; Farming&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-inner-circle?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83d\udc51&nbsp; Inner Circle&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-focus-tree?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83c\udf33&nbsp; Focus Tree&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-community?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83d\udc65&nbsp; Community&nbsp;\u2197</a><!--silo-bgm-injected--><style>\n.silo-bgm-bar {\n  font-family: Inter, sans-serif;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 10px;\n  box-sizing: border-box;\n  border: 1px solid #30363d;\n  border-radius: 6px;\n  background: #161b22;\n  color: #8b949e;\n  font-size: 12px;\n}\n.silo-bgm-bar--nav {\n  margin-left: auto;\n  flex-shrink: 0;\n}\n.silo-bgm-bar button {\n  padding: 6px 12px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 700;\n  font-size: 12px;\n  font-family: Inter, sans-serif;\n  background: #8957e5;\n  color: #fff;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);\n}\n.silo-bgm-bar button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n</style>\n<div id=\"_silo_bgm_wrap\" class=\"silo-bgm-bar silo-bgm-bar--nav\">\n  <button type=\"button\" id=\"_silo_bgm_btn\">Enable bunker audio</button>\n  <span id=\"_silo_bgm_status\">Optional bunker audio</span>\n</div>\n<script>\n(function siloBgmDashAudio() {\n  var TRACK = ('${bgm_url}' || '').trim();\n  var DASH = ('${dashboard_uid}' || '').trim();\n  var wrap = document.getElementById('_silo_bgm_wrap');\n  var btn = document.getElementById('_silo_bgm_btn');\n  var statusEl = document.getElementById('_silo_bgm_status');\n\n  if (!TRACK) {\n    if (wrap) wrap.style.display = 'none';\n    return;\n  }\n\n  var LS_KEY = 'silo_bgm_enabled';\n\n  var prev = window.__SILO_BGM__;\n  if (prev && prev.trackUrl === TRACK && prev.audio && typeof prev.remount === 'function') {\n    prev.dash = DASH;\n    prev.remount(wrap, btn, statusEl);\n    return;\n  }\n\n  if (prev && typeof prev.destroy === 'function') {\n    prev.destroy();\n  }\n\n  var audio = new Audio(TRACK);\n  audio.loop = true;\n  audio.volume = 0.35;\n\n  var navBtn = null;\n  var navStatus = null;\n\n  function teardown() {\n    if (api._onVis) {\n      document.removeEventListener('visibilitychange', api._onVis);\n    }\n    if (navBtn && api._onBtnClick) {\n      navBtn.removeEventListener('click', api._onBtnClick);\n    }\n    try {\n      audio.pause();\n      audio.removeAttribute('src');\n      audio.load();\n    } catch (e) {}\n  }\n\n  function onVis() {\n    if (document.hidden) {\n      audio.pause();\n    } else {\n      try {\n        if (localStorage.getItem(LS_KEY) === '1') {\n          tryPlay(false);\n        }\n      } catch (e) {}\n    }\n  }\n\n  function tryPlay(fromUser) {\n    var p = audio.play();\n    if (p !== undefined && typeof p.then === 'function') {\n      p.then(function () {\n        if (navBtn) navBtn.style.display = 'none';\n        if (navStatus) navStatus.textContent = 'Playing';\n      }).catch(function () {\n        if (navBtn) navBtn.style.display = '';\n        if (navStatus && !fromUser) {\n          navStatus.textContent = 'Tap Enable to play';\n        }\n      });\n    }\n  }\n\n  function remount(wrapEl, btnEl, statusElEl) {\n    if (navBtn && api._onBtnClick) {\n      navBtn.removeEventListener('click', api._onBtnClick);\n    }\n    navBtn = btnEl;\n    navStatus = statusElEl;\n    if (btnEl) {\n      btnEl.addEventListener('click', api._onBtnClick);\n    }\n    if (!audio.paused) {\n      if (btnEl) btnEl.style.display = 'none';\n      if (statusElEl) statusElEl.textContent = 'Playing';\n    } else {\n      if (btnEl) btnEl.style.display = '';\n      if (statusElEl && !document.hidden) {\n        try {\n          if (localStorage.getItem(LS_KEY) === '1') {\n            statusElEl.textContent = 'Tap Enable to play';\n          } else {\n            statusElEl.textContent = 'Optional bunker audio';\n          }\n        } catch (e) {\n          statusElEl.textContent = 'Optional bunker audio';\n        }\n      }\n    }\n  }\n\n  var api = {\n    dash: DASH,\n    trackUrl: TRACK,\n    destroy: function () {\n      teardown();\n      if (window.__SILO_BGM__ === api) {\n        window.__SILO_BGM__ = null;\n      }\n    },\n    audio: audio,\n    remount: remount,\n    _onVis: onVis,\n    _onBtnClick: function () {\n      try {\n        localStorage.setItem(LS_KEY, '1');\n      } catch (e) {}\n      tryPlay(true);\n    },\n  };\n\n  window.__SILO_BGM__ = api;\n\n  document.addEventListener('visibilitychange', onVis);\n\n  remount(wrap, btn, statusEl);\n\n  try {\n    if (localStorage.getItem(LS_KEY) === '1') {\n      tryPlay(false);\n    }\n  } catch (e) {}\n})();\n</script>\n<script>\n(function siloDashSfx() {\n  var urls = {\n    buttonClick: ('${sfx_button_click_url}' || '').trim(),\n  };\n\n  var pools = {};\n\n  function playUrl(url) {\n    if (!url) return;\n    var pool = pools[url];\n    if (!pool) {\n      pool = [];\n      pools[url] = pool;\n      for (var i = 0; i < 4; i++) {\n        var a = new Audio(url);\n        a.volume = 1;\n        pool.push(a);\n      }\n    }\n    var audio = pool[0];\n    var i;\n    for (i = 0; i < pool.length; i++) {\n      if (pool[i].paused || pool[i].ended) {\n        audio = pool[i];\n        break;\n      }\n      audio = pool[i];\n    }\n    try {\n      audio.currentTime = 0;\n      var p = audio.play();\n      if (p !== undefined && typeof p.then === 'function') {\n        p.catch(function () {});\n      }\n    } catch (e) {}\n  }\n\n  var api = {\n    urls: urls,\n    play: function (id) {\n      var u = urls[id];\n      if (!u) return;\n      playUrl(u);\n    },\n    register: function (id, url) {\n      if (!id) return;\n      urls[id] = (url || '').trim();\n    },\n  };\n\n  window.__SILO_SFX__ = api;\n\n  if (window.__SILO_SFX_CLICK_BOUND__) return;\n  window.__SILO_SFX_CLICK_BOUND__ = true;\n\n  document.addEventListener(\n    'click',\n    function (ev) {\n      var t = ev.target;\n      while (t && t.nodeType !== 1) t = t.parentElement;\n      if (!t || typeof t.closest !== 'function') return;\n      var el = t.closest('button');\n      if (!el) {\n        el = t.closest('input[type=\"button\"], input[type=\"submit\"]');\n      }\n      if (!el) return;\n\n      var sfxId = 'buttonClick';\n      var node = t;\n      while (node) {\n        if (node.hasAttribute && node.hasAttribute('data-sfx')) {\n          var v = node.getAttribute('data-sfx');\n          v = (v || '').trim();\n          if (v === 'none') return;\n          sfxId = v;\n          break;\n        }\n        if (node === el) break;\n        node = node.parentElement;\n      }\n\n      var sfx = window.__SILO_SFX__;\n      if (!sfx || typeof sfx.play !== 'function') return;\n      sfx.play(sfxId);\n    },\n    true\n  );\n})();\n</script>\n<!--/silo-bgm-injected--></div>"
      }
