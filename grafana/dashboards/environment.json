{
  "uid": "silo-environment",
  "title": "Silo: Environment",
  "tags": ["silo", "game"],
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "10s",
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"]
  },
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User ID",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""},
        "options": [],
        "hide": 2,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "html",
        "content": "<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(31,111,235,0.15);border:1px solid #1f6feb;color:#58a6ff;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">☢&nbsp; Environment</span><a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">⚡&nbsp; Power Systems&nbsp;↗</a><a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" target=\"_blank\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">🌾&nbsp; Farming&nbsp;↗</a></div>"
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "📡 System Messages",
      "datasource": null,
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 5},
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-log {\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n  background: #0d0d0d;\n  padding: 8px 12px;\n  height: 100%;\n  box-sizing: border-box;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  border-radius: 3px;\n}\n.silo-log .msg { margin: 1px 0; }\n.silo-log .ts { color: #3a3a3a; font-size: 10px; margin-right: 6px; }\n.silo-log .prefix { color: #555; margin-right: 4px; }\n.silo-log .body { color: #8fbc8f; }\n.silo-log .empty { color: #333; font-style: italic; }\n</style>\n<div class=\"silo-log\" id=\"_silo_log\"><span class=\"empty\">Awaiting transmissions...</span></div>\n<script>\nfunction _siloLoadMsgs() {\n  fetch('http://localhost:5001/system-messages?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(msgs) {\n      var el = document.getElementById('_silo_log');\n      if (!msgs || !msgs.length) {\n        el.innerHTML = '<span class=\"empty\">Awaiting transmissions...</span>';\n        return;\n      }\n      el.innerHTML = msgs.map(function(m) {\n        var safe = m.body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n        return '<div class=\"msg\"><span class=\"ts\">[' + m.ts + ']</span><span class=\"prefix\">&gt;</span><span class=\"body\">' + safe + '</span></div>';\n      }).join('');\n      el.scrollTop = el.scrollHeight;\n    })\n    .catch(function() {});\n}\n_siloLoadMsgs();\nsetInterval(_siloLoadMsgs, 5000);\n</script>"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outdoor radiation (rads)",
      "description": "Outdoor sensor readout (noisy, like a Geiger-style instrument). The orange line marks the threshold below which residents begin reconsidering their stay; gameplay uses the smooth underlying level.",
      "datasource": {"type": "postgres", "uid": "silo-postgres"},
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 10},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 4,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "thresholdsStyle": {"mode": "line"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "orange", "value": 50}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "silo-postgres"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, COALESCE(level_display, level) AS \"Outdoor radiation\" FROM radiation_levels WHERE '$user_id' <> '' AND user_id = '$user_id'::uuid AND $__timeFilter(timestamp) ORDER BY timestamp"
        }
      ]
    },
