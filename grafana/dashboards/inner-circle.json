      "options": {
        "mode": "html",
        "content": "<script>\n(function() {\n  var uid = '${user_id}';\n  if (uid) {\n    try { localStorage.setItem('silo_user_id', uid); } catch(e) {}\n  } else {\n    var saved;\n    try { saved = localStorage.getItem('silo_user_id'); } catch(e) {}\n    if (saved) {\n      var url = new URL(window.location.href);\n      url.searchParams.set('var-user_id', saved);\n      url.searchParams.set('kiosk', 'tv');\n      window.location.replace(url.toString());\n    } else {\n      window.location.replace('http://localhost:5001');\n    }\n  }\n})();\n</script>\n<div style=\"display:flex;align-items:center;gap:10px;padding:8px 16px;height:100%;box-sizing:border-box;font-family:Inter,sans-serif;\"><span style=\"color:#555;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;flex-shrink:0;\">Silo Command</span><div style=\"width:1px;height:20px;background:#333;margin:0 4px;flex-shrink:0;\"></div><a href=\"http://localhost:3000/d/silo-environment?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\u2622&nbsp; Environment&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-power?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\u26a1&nbsp; Power Systems&nbsp;\u2197</a><a href=\"http://localhost:3000/d/silo-farming?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83c\udf3e&nbsp; Farming&nbsp;\u2197</a><span style=\"display:inline-flex;align-items:center;padding:5px 14px;background:rgba(191,75,138,0.15);border:1px solid #bf4b8a;color:#ff7b72;border-radius:4px;font-weight:700;font-size:13px;flex-shrink:0;\">\ud83d\udc51&nbsp; Inner Circle</span><a href=\"http://localhost:3000/d/silo-community?var-user_id=${user_id}&kiosk=tv\" style=\"display:inline-flex;align-items:center;padding:5px 14px;color:#888;border-radius:4px;text-decoration:none;font-weight:600;font-size:13px;border:1px solid transparent;flex-shrink:0;\">\ud83d\udc65&nbsp; Community&nbsp;\u2197</a></div>"
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "\ud83d\udce1 System Messages",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "html",
        "content": "<style>\n.silo-log {\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n  background: #0d0d0d;\n  padding: 8px 12px;\n  height: 100%;\n  box-sizing: border-box;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  border-radius: 3px;\n}\n.silo-log .msg { margin: 1px 0; }\n.silo-log .ts { color: #3a3a3a; font-size: 10px; margin-right: 6px; }\n.silo-log .prefix { color: #555; margin-right: 4px; }\n.silo-log .body { color: #8fbc8f; }\n.silo-log .empty { color: #333; font-style: italic; }\n.silo-log .urgency {\n  margin-right: 6px;\n  font-size: 13px;\n  line-height: 1;\n  vertical-align: middle;\n  font-family: 'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji',sans-serif;\n}\n</style>\n<div class=\"silo-log\" id=\"_silo_log\"><span class=\"empty\">Awaiting transmissions...</span></div>\n<script>\n(function(){\nvar _siloLastLogHtml = null;\nfunction _siloLoadMsgs() {\n  fetch('http://localhost:5001/system-messages?user_id=${user_id}')\n    .then(function(r) { return r.json(); })\n    .then(function(msgs) {\n      var el = document.getElementById('_silo_log');\n      if (!el) return;\n      var html;\n      if (!msgs || !msgs.length) {\n        html = '<span class=\"empty\">Awaiting transmissions...</span>';\n      } else {\n        html = msgs.map(function(m) {\n          var safe = m.body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n          var emoji = (m.emoji != null && String(m.emoji).length) ? String(m.emoji) : '\\u2139\\ufe0f';\n          return '<div class=\"msg\"><span class=\"urgency\">' + emoji + '</span><span class=\"ts\">[' + m.ts + ']</span><span class=\"prefix\">&gt;</span><span class=\"body\">' + safe + '</span></div>';\n        }).join('');\n      }\n      if (html === _siloLastLogHtml) return;\n      _siloLastLogHtml = html;\n      el.innerHTML = html;\n      el.scrollTop = el.scrollHeight;\n    })\n    .catch(function() {});\n}\n_siloLoadMsgs();\nsetInterval(_siloLoadMsgs, 5000);\n})();\n</script>"
      }
    },
    {
